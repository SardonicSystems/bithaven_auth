# BitHaven (club) values. Copy to bithaven.env and fill in. Secrets are NOT here: they go in secrets/.

# --- Names and TLS ---
NETBIRD_HOST=netbird.example.org          # public, Let's Encrypt
AUTH_HOST=auth.example.org                # public, Let's Encrypt
INTERNAL_DOMAIN=example.lan
ACME_EMAIL=admin@example.org
ACME_CHALLENGE=dns01                      # dns01|http01
ACME_DNS_PROVIDER=cloudflare
ACME_CA=                                  # empty = Let's Encrypt production
ACME_DNS_TOKEN_FILE=secrets/cloudflare_dns_token   # zone-scoped; DNS-01 only
INTERNAL_TLS_MODE=caddy-internal          # caddy-internal|file
NETBIRD_SERVER_UPSTREAM=                  # netbird-server host:port, e.g. 192.168.1.30:8081; empty = placeholder vhost
NETBIRD_DASHBOARD_UPSTREAM=               # NetBird dashboard host:port, e.g. 192.168.1.30:8080
INTERNAL_CA_CERT_PATH=                    # used when INTERNAL_TLS_MODE=file

# --- Network ---
PROXY_IP=192.168.1.20
APP_IP=192.168.1.21
NET_PREFIX=24
NET_GATEWAY=192.168.1.1
DNS_RESOLVERS="192.168.1.1"

# --- FreeIPA (theirs) ---
IPA_HOST=ipa.example.lan
IPA_IP=192.168.1.10
IPA_REALM=EXAMPLE.LAN
IPA_BASEDN=dc=example,dc=lan
IPA_CA_CERT_PATH=secrets/ipa-ca.crt
IPA_CA_SHA256=                            # sha256 of the IPA CA cert (pin); install fails on mismatch
IPA_GROUP_MEMBERS=netbird_members
IPA_GROUP_ADMINS=netbird_member_admins
NETBIRD_GROUPS_REGEX=^netbird_      # only groups matching this reach NetBird in the OIDC groups claim
LDAP_SYNC_CRON="*/10 * * * *"        # how often Authentik syncs IPA users/groups (= worst-case revocation delay)
IPA_SYNC_UID=svc_bh_sync
IPA_PROVISION_UID=svc_bh_provision
# bind passwords: secrets/ipa_sync_password, secrets/ipa_provision_password

# --- Mail ---
AUP_URL=https://example.org/aup               # link shown on the enrollment form
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=noreply@example.org
SMTP_TLS=starttls                         # starttls|tls|none
# credentials: secrets/smtp_password, SMTP_USER below
SMTP_USER=

# --- Pinned versions (resolved 2026-10-07; re-check before club deploy) ---
DEBIAN_RELEASE=bookworm
AUTHENTIK_VERSION=2026.8.3
NETBIRD_VERSION=0.80.0
CADDY_VERSION=2.11.7
POSTGRES_VERSION=16
