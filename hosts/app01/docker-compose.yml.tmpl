services:
  postgresql:
    image: postgres:${POSTGRES_VERSION}-alpine
    restart: unless-stopped
    env_file: [.env]
    environment:
      POSTGRES_DB: "${PG_DB}"
      POSTGRES_USER: "${PG_USER}"
      POSTGRES_PASSWORD: "${PG_PASS}"
    volumes:
      - database:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s

  server:
    image: ghcr.io/goauthentik/server:${AUTHENTIK_VERSION}
    restart: unless-stopped
    command: server
    env_file: [.env]
    volumes:
      - ./data:/data
      - ./custom-templates:/templates
      - ./certs:/certs
      - ./blueprints:/blueprints/custom
    ports:
      - "${APP_IP}:9000:9000"
    shm_size: 512mb
    depends_on:
      postgresql:
        condition: service_healthy

  worker:
    image: ghcr.io/goauthentik/server:${AUTHENTIK_VERSION}
    restart: unless-stopped
    command: worker
    env_file: [.env]
    user: root
    volumes:
      - ./data:/data
      - ./certs:/certs
      - ./custom-templates:/templates
      - ./blueprints:/blueprints/custom
    shm_size: 512mb
    depends_on:
      postgresql:
        condition: service_healthy

volumes:
  database:
    driver: local
